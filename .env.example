# ══════════════════════════════════════════════════════════════════════════════
#  Network Observability Platform — Environment Configuration
#  Copy this file to .env and fill in real values. Never commit .env to git.
# ══════════════════════════════════════════════════════════════════════════════

# ── Global ────────────────────────────────────────────────────────────────────
ENVIRONMENT=local                      # local | staging | production
PROJECT_NAME=netobserv
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR

# ── Anthropic / Claude API ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
CLAUDE_MODEL=claude-sonnet-4-6         # model ID used by the agent service

# ── Redpanda (Kafka-compatible) ───────────────────────────────────────────────
# Docker services use redpanda:9092; host tools (rpk, kcat) use localhost:9092
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_TOPIC_FLOWS=network.flows
KAFKA_TOPIC_BGP=network.bgp
KAFKA_TOPIC_SNMP=network.snmp
KAFKA_TOPIC_ANOMALIES=anomalies.scored
KAFKA_TOPIC_RUNBOOKS=anomalies.runbooks
KAFKA_TOPIC_TOPOLOGY_UPDATES=topology.updates
KAFKA_CONSUMER_GROUP=netobserv-group
KAFKA_COLLECTOR_GROUP_PREFIX=netobserv-collector
KAFKA_AUTO_OFFSET_RESET=earliest

# ── InfluxDB ──────────────────────────────────────────────────────────────────
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=netobserv-local-token
INFLUXDB_ORG=netobserv
INFLUXDB_BUCKET=metrics
INFLUXDB_RETENTION=7d
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=changeme_local

# ── OpenSearch ────────────────────────────────────────────────────────────────
OPENSEARCH_HOST=http://opensearch:9200
OPENSEARCH_INDEX_EVENTS=network-events
OPENSEARCH_INDEX_RUNBOOKS=runbooks
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=changeme_local
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

# ── DynamoDB (local) ──────────────────────────────────────────────────────────
DYNAMODB_ENDPOINT_URL=http://dynamodb-local:8000   # blank on real AWS
DYNAMODB_REGION=us-east-1
DYNAMODB_TABLE_TOPOLOGY=network-topology
DYNAMODB_TABLE_LINKS=network-links
AWS_ACCESS_KEY_ID=fakekey                           # local only
AWS_SECRET_ACCESS_KEY=fakesecret                    # local only

# ── MinIO (S3-compatible) ─────────────────────────────────────────────────────
# S3_ACCESS_KEY / S3_SECRET_KEY are also used as MINIO_ROOT_USER / MINIO_ROOT_PASSWORD
S3_ENDPOINT_URL=http://minio:9000                  # blank on real AWS
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=changeme_local
S3_BUCKET_ARCHIVE=netobserv-archive
S3_BUCKET_RUNBOOKS=netobserv-runbooks
S3_REGION=us-east-1

# ── Postgres + pgvector ───────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=netobserv
POSTGRES_USER=netobserv
POSTGRES_PASSWORD=changeme_local
POSTGRES_POOL_SIZE=10
VECTOR_EMBEDDING_MODEL=text-embedding-3-small       # OpenAI embeddings (or swap)
VECTOR_DIMENSIONS=1536

# ── Collector ─────────────────────────────────────────────────────────────────
# Batch sizes are tuned in services/collector; override here if you need to.
COLLECTOR_INFLUXDB_BATCH_SIZE=500
COLLECTOR_OPENSEARCH_BULK_SIZE=100
COLLECTOR_S3_FLUSH_INTERVAL_SECONDS=60

# ── Topology ──────────────────────────────────────────────────────────────────
KAFKA_TOPOLOGY_GROUP_PREFIX=netobserv-topology
TOPOLOGY_REFRESH_INTERVAL=300          # seconds between full DynamoDB rehydrations
TRAFFIC_EWMA_ALPHA=0.2                 # flow utilisation smoothing factor (0,1]

# ── Simulator ─────────────────────────────────────────────────────────────────
SIMULATOR_PRODUCER_RATE=75             # target flow records per second
SIMULATOR_SCENARIO_MODE=scheduled      # scheduled | random | single
SIMULATOR_SCENARIO=normal              # used only when SIMULATOR_SCENARIO_MODE=single
SIMULATOR_ANOMALY_INTERVAL_MINUTES=15  # minutes between scenario injections
SIMULATOR_SNMP_INTERVAL_SECONDS=30     # per-device SNMP polling interval

# ── Anomaly Detection ─────────────────────────────────────────────────────────
ANOMALY_WINDOW_SECONDS=60             # sliding window for feature extraction
ANOMALY_SCORE_THRESHOLD=0.7           # Isolation Forest score above which = anomaly
ANOMALY_MODEL_PATH=/app/models/iforest.pkl
ANOMALY_RETRAIN_INTERVAL_HOURS=24

# ── Agent ─────────────────────────────────────────────────────────────────────
AGENT_RAG_TOP_K=5                      # number of similar runbooks to retrieve
AGENT_MAX_TOKENS=4096
AGENT_TEMPERATURE=0.2

# ── FastAPI Backend ───────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
API_SECRET_KEY=changeme_jwt_secret_local
API_TOKEN_EXPIRE_MINUTES=60

# ── Frontend ──────────────────────────────────────────────────────────────────
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8000/ws
REACT_APP_ENV=local

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_local
GRAFANA_PORT=3001

# ── AWS (only needed for tf-plan / tf-apply — ignored locally) ───────────────
AWS_REGION=us-east-1
TF_VAR_project_name=netobserv
TF_VAR_environment=production

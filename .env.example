# ══════════════════════════════════════════════════════════════════════════════
#  Network Observability Platform — Environment Configuration
#  Copy this file to .env and fill in real values. Never commit .env to git.
# ══════════════════════════════════════════════════════════════════════════════

# ── Global ────────────────────────────────────────────────────────────────────
ENVIRONMENT=local                      # local | staging | production
PROJECT_NAME=netobserv
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR

# ── LLM provider (Google Gemini via langchain-google-genai) ───────────────────
# The agent service uses Google Gemini for tool-calling investigations.
# Get a key from https://aistudio.google.com/app/apikey (free tier available).
GOOGLE_API_KEY=REPLACE_ME
GEMINI_MODEL=gemini-2.0-flash          # model ID used by the agent service

# ── Redpanda (Kafka-compatible) ───────────────────────────────────────────────
# Docker services use redpanda:9092; host tools (rpk, kcat) use localhost:9092
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_TOPIC_FLOWS=network.flows
KAFKA_TOPIC_BGP=network.bgp
KAFKA_TOPIC_SNMP=network.snmp
KAFKA_TOPIC_ANOMALIES=anomalies.scored
KAFKA_TOPIC_RUNBOOKS=anomalies.runbooks
KAFKA_TOPIC_TOPOLOGY_UPDATES=topology.updates
KAFKA_CONSUMER_GROUP=netobserv-group
KAFKA_COLLECTOR_GROUP_PREFIX=netobserv-collector
KAFKA_AUTO_OFFSET_RESET=earliest

# ── InfluxDB ──────────────────────────────────────────────────────────────────
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=netobserv-local-token
INFLUXDB_ORG=netobserv
INFLUXDB_BUCKET=metrics
INFLUXDB_RETENTION=7d
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=changeme_local

# ── OpenSearch ────────────────────────────────────────────────────────────────
OPENSEARCH_HOST=http://opensearch:9200
OPENSEARCH_INDEX_EVENTS=network-events
OPENSEARCH_INDEX_RUNBOOKS=runbooks
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=changeme_local
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

# ── DynamoDB (local) ──────────────────────────────────────────────────────────
DYNAMODB_ENDPOINT_URL=http://dynamodb-local:8000   # blank on real AWS
DYNAMODB_REGION=us-east-1
DYNAMODB_TABLE_TOPOLOGY=network-topology
DYNAMODB_TABLE_LINKS=network-links
AWS_ACCESS_KEY_ID=fakekey                           # local only
AWS_SECRET_ACCESS_KEY=fakesecret                    # local only

# ── MinIO (S3-compatible) ─────────────────────────────────────────────────────
# S3_ACCESS_KEY / S3_SECRET_KEY are also used as MINIO_ROOT_USER / MINIO_ROOT_PASSWORD
S3_ENDPOINT_URL=http://minio:9000                  # blank on real AWS
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=changeme_local
S3_BUCKET_ARCHIVE=netobserv-archive
S3_BUCKET_RUNBOOKS=netobserv-runbooks
S3_REGION=us-east-1

# ── Postgres + pgvector ───────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=netobserv
POSTGRES_USER=netobserv
POSTGRES_PASSWORD=changeme_local
POSTGRES_POOL_SIZE=10
# Embedding model used by the agent's RAG knowledge base. Changing this
# requires rebuilding the runbook_chunks table with a matching vector(N) column
# AND re-running the seed script. The default is 384-dim and CPU-friendly.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
# Seed-script knobs (scripts/seed_runbooks.py):
RUNBOOKS_DIR=/data/runbooks            # path inside the seed container; host volume mounts ./data/runbooks
CHUNK_MAX_TOKENS=300                   # paragraph-aware chunk size (in words ≈ tokens)
CHUNK_OVERLAP_TOKENS=50                # word overlap between sequential chunks

# ── Collector ─────────────────────────────────────────────────────────────────
# Batch sizes are tuned in services/collector; override here if you need to.
COLLECTOR_INFLUXDB_BATCH_SIZE=500
COLLECTOR_OPENSEARCH_BULK_SIZE=100
COLLECTOR_S3_FLUSH_INTERVAL_SECONDS=60

# ── Topology ──────────────────────────────────────────────────────────────────
KAFKA_TOPOLOGY_GROUP_PREFIX=netobserv-topology
TOPOLOGY_REFRESH_INTERVAL=300          # seconds between full DynamoDB rehydrations
TRAFFIC_EWMA_ALPHA=0.2                 # flow utilisation smoothing factor (0,1]

# ── Simulator ─────────────────────────────────────────────────────────────────
SIMULATOR_PRODUCER_RATE=75             # target flow records per second
SIMULATOR_SCENARIO_MODE=scheduled      # scheduled | random | single
SIMULATOR_SCENARIO=normal              # used only when SIMULATOR_SCENARIO_MODE=single
SIMULATOR_ANOMALY_INTERVAL_MINUTES=15  # minutes between scenario injections
SIMULATOR_SNMP_INTERVAL_SECONDS=30     # per-device SNMP polling interval

# ── Anomaly Detection ─────────────────────────────────────────────────────────
# Phase 3.2 (real-time engine) — sliding-window scoring config:
ANOMALY_MODEL_KEY=models/baseline-latest.tar.gz   # S3 key of the bundle the engine loads
ANOMALY_WINDOW_SECONDS_RT=10          # window length for the live scorer (seconds)
ANOMALY_INFO_THRESHOLD=0.3            # unified score ≥ this → INFO
ANOMALY_WARN_THRESHOLD=0.6            # unified score ≥ this → WARN
ANOMALY_CRITICAL_THRESHOLD=0.85       # unified score ≥ this → CRITICAL (fires Slack)
ANOMALY_MODEL_WAIT_POLL_SECONDS=10    # poll interval while waiting for the first bundle
ANOMALY_MODEL_WAIT_MAX_SECONDS=0      # 0 = wait forever; >0 = give up after N seconds
KAFKA_ANOMALY_GROUP_PREFIX=netobserv-anomaly      # consumer-group prefix per topic
TOPOLOGY_SERVICE_URL=http://topology:8080         # base URL for /topology/affected enrichment
SLACK_WEBHOOK_URL=                    # blank = silent; set to a real webhook to enable CRITICAL alerts

# Phase 3.1 (baseline trainer) — `docker compose --profile training up baseline`:
ANOMALY_LOOKBACK_HOURS=24             # training window in hours (1..168)
ANOMALY_BGP_INDEX_PATTERN=bgp-events-* # OpenSearch index pattern for BGP events
ANOMALY_MODEL_PREFIX=models            # S3/MinIO key prefix for model bundles
ANOMALY_CONTAMINATION_TRAFFIC=0.05    # PyOD contamination, traffic IForest
ANOMALY_CONTAMINATION_BGP=0.05        # PyOD contamination, BGP LOF
ANOMALY_CONTAMINATION_SNMP=0.05       # PyOD contamination, SNMP MCD
ANOMALY_MIN_TRAINING_MINUTES=30       # min per-minute rows required to train a model
ANOMALY_RANDOM_SEED=42                # reproducibility

# ── Agent ─────────────────────────────────────────────────────────────────────
# Phase 4.1 (RAG knowledge base):
RAG_TOP_K=5                            # number of similar runbook chunks to retrieve per query
# Phase 4.2 (LangChain Gemini investigator):
AGENT_MAX_TOKENS=4096                  # max output tokens per LLM call
AGENT_TEMPERATURE=0.2                  # 0 = deterministic, 1 = creative
AGENT_KAFKA_CONSUMER_GROUP=netobserv-agent
AGENT_MAX_TOOL_CALLS=8                 # hard cap on tool invocations per investigation
AGENT_INVESTIGATION_TIMEOUT_SECONDS=120 # wall-clock budget per investigation
AGENT_INVESTIGATE_SEVERITIES=WARN,CRITICAL  # comma-separated; INFO is logged but not investigated
OPENSEARCH_BGP_INDEX_PATTERN=bgp-events-*
OPENSEARCH_ANOMALIES_INDEX_PATTERN=anomalies-*

# ── FastAPI Backend ───────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
API_SECRET_KEY=changeme_jwt_secret_local
API_TOKEN_EXPIRE_MINUTES=60

# ── Frontend ──────────────────────────────────────────────────────────────────
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8000/ws
REACT_APP_ENV=local

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_local
GRAFANA_PORT=3001

# ── AWS (only needed for tf-plan / tf-apply — ignored locally) ───────────────
AWS_REGION=us-east-1
TF_VAR_project_name=netobserv
TF_VAR_environment=production
